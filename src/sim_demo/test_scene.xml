<mujoco model="test_scene">
  <option gravity="0 0 -9.81"/>

  <worldbody>
    <light diffuse="1 1 1" pos="0 0 3" dir="0 0 -1"/>
    <geom type="plane" size="2 2 0.1" rgba="0.8 0.8 0.8 1"/>

    <!-- A simple two-link arm - now motor-driven, commandable from ROS 2 -->
    <body name="link1" pos="0 0 1">
      <joint name="joint1" type="hinge" axis="0 1 0" damping="0.5"/>
      <geom type="capsule" fromto="0 0 0 0 0 -0.4" size="0.04" rgba="0.2 0.6 0.9 1"/>

      <body name="link2" pos="0 0 -0.4">
        <joint name="joint2" type="hinge" axis="0 1 0" damping="0.5"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.4" size="0.035" rgba="0.9 0.4 0.2 1"/>

        <!-- a little disk at the tip, standing in for your axle/encoder -->
        <body name="wheel" pos="0 0 -0.4">
          <joint name="axle" type="hinge" axis="0 1 0" damping="0.02"/>
          <geom type="cylinder" size="0.08 0.02" rgba="0.3 0.3 0.3 1" euler="90 0 0"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Torque motors - ROS 2 (via /cmd_torque) drives these directly -->
    <motor name="motor1" joint="joint1" ctrlrange="-5 5"/>
    <motor name="motor2" joint="joint2" ctrlrange="-5 5"/>
  </actuator>
</mujoco>
